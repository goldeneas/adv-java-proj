<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="15.0" prefWidth="500.0" prefHeight="400.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ResultViewController">
   <children>
      <Label text="MyMathQuiz">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <TableView fx:id="tabellaRisultati" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colTentativo" text="Tentativo" />
          <TableColumn fx:id="colEsito" text="Esito" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      
      <VBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label fx:id="labelMessaggio" text="Grazie per aver completato il quiz. Esporta i tuoi risultati su file." wrapText="true" />
         </children>
      </VBox>
      
      <Button fx:id="btnEsporta" onAction="#handleEsporta" text="Esporta" />
   </children>
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
   </padding>
</VBox>