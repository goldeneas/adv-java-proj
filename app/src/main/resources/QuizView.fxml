<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox alignment="CENTER" spacing="15.0">
         <children>
            <Label fx:id="questionLabel" text="39 + 44 = ?">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>

            <Label fx:id="progressLabel" text="1/3">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>

            <TextField fx:id="answerField" alignment="CENTER" maxWidth="150.0" promptText="Risposta">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>

            <Button fx:id="nextButton" mnemonicParsing="false" onAction="#handleNextAction" text="Avanti">
               <font>
                  <Font size="14.0" />
               </font>
               <padding>
                  <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
               </padding>
            </Button>

            <Label fx:id="timerLabel" text="00:30" textFill="RED">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</StackPane>